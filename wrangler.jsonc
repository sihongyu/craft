{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "camm-ai",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client"
  },
  "d1_databases": [
    {
      "binding": "xxx_db",
      "database_name": "xxx-db",
      "database_id": "000000000000000000000000000000",
      "migrations_dir": "migrations/user"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "xxxx-ai-media"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true,
      "allowed_sender_addresses": ["welcome@xxxx.ai"]
    }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "",
    "GOOGLE_CLIENT_SECRET": "",
    "GITHUB_CLIENT_ID": "",
    "GITHUB_CLIENT_SECRET": ""
  }
}
